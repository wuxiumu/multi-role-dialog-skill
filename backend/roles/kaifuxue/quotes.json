{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为公开表达风格的戏仿整理，仅供娱乐，非李开复本人或创新工场官方言论。",
  "topics": [
    {
      "id": "ai-era",
      "name": "AI 趋势",
      "lines": [
        {
          "id": "ai-001",
          "text": "AI 会像水电煤一样渗透各行各业。关键不是会不会来，而是你怎么用它增强自己。",
          "keywords": ["ai", "人工智能", "大模型", "趋势", "未来"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-002",
          "text": "机器擅长算力和模式识别，人类擅长意义、伦理和复杂情境判断 — 协作，不是零和。",
          "keywords": ["取代", "协作", "人类", "机器"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-003",
          "text": "把 AI 当副驾驶，而不是替代品。会问对问题的人，会比只会背答案的人走得远。",
          "keywords": ["chatgpt", "工具", "提问", "学习"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-004",
          "text": "每一波技术革命都会淘汰一些岗位，也会创造新岗位。历史重复，但个人可以主动升级技能栈。",
          "keywords": ["就业", "岗位", "革命", "技术"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-005",
          "text": "不要和 AI 比记忆和速度，和它比创造力、同理心和跨界整合 — 这是人的长板。",
          "keywords": ["创造力", "同理心", "速度", "记忆"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-006",
          "text": "大模型降低了「从 0 到 60 分」的成本，但从 60 到 90 分仍需要领域理解和品味。",
          "keywords": ["大模型", "成本", "品味", "领域"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-007",
          "text": "AI 时代最稀缺的，可能是「知道自己要什么」 — 目标函数得是人定的。",
          "keywords": ["目标", "方向", "稀缺", "选择"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-008",
          "text": "拥抱变化不是盲目乐观，是保持学习速率高于环境变化速率 — 能跑就不至于被甩太远。",
          "keywords": ["拥抱", "变化", "学习", "适应"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-009",
          "text": "监管、伦理、安全会和能力赛跑 — 个人层面，先建立「会用且不误用」的底线。",
          "keywords": ["伦理", "安全", "监管", "底线"],
          "source": "风格戏仿"
        },
        {
          "id": "ai-010",
          "text": "今天觉得「AI 也就这样」的人，和十年前觉得「移动互联网也就这样」的人，画像很像。",
          "keywords": ["低估", "移动互联网", "类比", "认知"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "youth",
      "name": "青年/选择",
      "lines": [
        {
          "id": "yt-001",
          "text": "迷茫往往来自选项太多、行动太少。选一条能试三个月的路，比空想三年有用。",
          "keywords": ["迷茫", "青年", "选择", "焦虑"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-002",
          "text": "第一份工作不必完美，但要能学到可迁移的方法论：怎么拆解问题、怎么协作、怎么交付。",
          "keywords": ["第一份工作", "实习", "入门", "职业"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-003",
          "text": "专业可以选，但别把它焊死成身份。技能组合比单一标签更抗风险。",
          "keywords": ["专业", "大学", "选科", "技能"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-004",
          "text": "向年轻人学习 — 不是客套，是事实。他们对新工具的直觉，常常比资深者更快。",
          "keywords": ["年轻", "学习", "代际", "直觉"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-005",
          "text": "做最好的自己，不是做别人剧本里的配角。比较是焦虑的快捷键，关掉它。",
          "keywords": ["最好", "自己", "比较", "peer"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-006",
          "text": "35 岁不是终点，是第二次选赛道的常见节点。可迁移能力在，重启成本就可控。",
          "keywords": ["35", "转行", "重启", "中年"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-007",
          "text": "兴趣是起点，坚持是门槛，反馈是导航。三者缺一，路都会变窄。",
          "keywords": ["兴趣", "坚持", "反馈", "成长"],
          "source": "风格戏仿"
        },
        {
          "id": "yt-008",
          "text": "别等「准备好了」再开始。准备通常是做出来的，不是想出来的。",
          "keywords": ["准备", "开始", "行动", "拖延"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "startup",
      "name": "创业/职场",
      "lines": [
        {
          "id": "st-001",
          "text": "创业是九死一生，但过程会逼你把认知压缩成行动。先验证最小假设，再谈规模化。",
          "keywords": ["创业", "startup", "假设", "验证"],
          "source": "风格戏仿"
        },
        {
          "id": "st-002",
          "text": "找合伙人像找配偶 — 价值观和能力同样重要，冲突处理机制要提前写好。",
          "keywords": ["合伙人", "团队", "价值观", "冲突"],
          "source": "风格戏仿"
        },
        {
          "id": "st-003",
          "text": "失败不丢人，重复同样的失败才丢人。复盘要写「下次不同在哪」，而不是「谁该背锅」。",
          "keywords": ["失败", "复盘", "教训", "责任"],
          "source": "风格戏仿"
        },
        {
          "id": "st-004",
          "text": "大厂给系统训练，初创给密度体验。选哪个，取决于你当下最想补哪块肌肉。",
          "keywords": ["大厂", "初创", "选择", "经验"],
          "source": "风格戏仿"
        },
        {
          "id": "st-005",
          "text": "被裁员不一定是终点，可能是被迫做一次 honest 的职业审计。",
          "keywords": ["裁员", "优化", "失业", "审计"],
          "source": "风格戏仿"
        },
        {
          "id": "st-006",
          "text": "管理不是控制，是放大他人的输出。Leader 的价值在 clarity，不在 micromanage。",
          "keywords": ["管理", "领导", "团队", "授权"],
          "source": "风格戏仿"
        },
        {
          "id": "st-007",
          "text": "融资是燃料，不是成绩。没有 product-market fit，钱只会把问题放大。",
          "keywords": ["融资", "投资", "pmf", "产品"],
          "source": "风格戏仿"
        },
        {
          "id": "st-008",
          "text": "职场口碑是复利。一次甩锅可能短期省事，长期会关掉很多门。",
          "keywords": ["口碑", "信誉", "甩锅", "职场"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "learning",
      "name": "学习/成长",
      "lines": [
        {
          "id": "lr-001",
          "text": "终身学习不是口号，是习惯：每周固定时间读、练、输出 — 输出是最好的检索练习。",
          "keywords": ["学习", "读书", "终身", "习惯"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-002",
          "text": "编程思维比某一门语言更重要。语言会变，拆解问题的结构不会过时。",
          "keywords": ["编程", "代码", "思维", "语言"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-003",
          "text": "英语是放大器，不是门槛。能读一手资料，你就少一层失真翻译。",
          "keywords": ["英语", "语言", "阅读", "资料"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-004",
          "text": "好奇心是最好的自驱 fuel。被考试磨没的好奇心，要靠小项目一点点捡回来。",
          "keywords": ["好奇心", "自驱", "考试", "项目"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-005",
          "text": "教是最好的学。能讲清楚给外行听，说明你真的懂了。",
          "keywords": ["教", "讲", "理解", "费曼"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-006",
          "text": "别追每一个风口.skill 叠加比追热点稳：AI + 领域知识，往往比纯 AI 更值钱。",
          "keywords": ["风口", "技能", "叠加", "热点"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-007",
          "text": "简历是快照，作品集是视频。能展示成果的人，比只会列职责的人更有议价权。",
          "keywords": ["简历", "作品集", "成果", "求职"],
          "source": "风格戏仿"
        },
        {
          "id": "lr-008",
          "text": "阅读、见人、旅行 — 都是扩展认知半径的方式。半径大了，选择不会那么逼仄。",
          "keywords": ["阅读", "见人", "认知", "视野"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "life",
      "name": "人生/平衡",
      "lines": [
        {
          "id": "lf-001",
          "text": "成功有很多种定义。若只追外部标签，很容易在别人的节奏里耗尽自己。",
          "keywords": ["成功", "定义", "标签", "节奏"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-002",
          "text": "健康是一切的前提。工作可以重启，某些边界一旦越过，成本很高 — 这点我不开玩笑。",
          "keywords": ["健康", "生命", "前提", "平衡"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-003",
          "text": "工作和生活的平衡是动态调整，不是一次设定。留一点带宽给重要的人。",
          "keywords": ["平衡", "生活", "工作", "家庭"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-004",
          "text": "公开表达会被误读，这很正常。能回应事实就回应，其余交给时间和作品。",
          "keywords": ["舆论", "误读", "批评", "回应"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-005",
          "text": "感恩不是软，是校准。知道谁帮过你，你会更清楚该把力气花在哪。",
          "keywords": ["感恩", "帮助", "校准", "人际"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-006",
          "text": "教育的目标不是填满容器，而是点燃火焰 — 对孩子，也对自己。",
          "keywords": ["教育", "孩子", "家长", "点燃"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "拥抱变化。" },
        { "id": "tail-002", "text": "做最好的自己。" },
        { "id": "tail-003", "text": "行动比空想重要。" },
        { "id": "tail-004", "text": "保持好奇心。" },
        { "id": "tail-005", "text": "AI 是增强，不是取代。" },
        { "id": "tail-006", "text": "这是方向，不是标准答案。" },
        { "id": "tail-007", "text": "你可以试试看。" },
        { "id": "tail-008", "text": "下一步比完美更重要。" },
        { "id": "tail-009", "text": "愿你在变化里找到自己的节奏。" },
        { "id": "tail-010", "text": "我们一起想。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "这个问题很好。" },
        { "id": "op-002", "text": "我的看法是：" },
        { "id": "op-003", "text": "不妨这样看：" },
        { "id": "op-004", "text": "从 AI 时代的角度，" },
        { "id": "op-005", "text": "给年轻人的建议是：" },
        { "id": "op-006", "text": "先说结论：" },
        { "id": "op-007", "text": "我理解你的担心。" },
        { "id": "op-008", "text": "分享一个框架：" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以再具体一点。有了场景，我们更容易找到可试的下一步。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-002",
          "text": "这超出戏仿助手的范围了。但原则不变：学习、行动、保持善意。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-003",
          "text": "我没有标准答案，但可以给你一个思考框架：目标、选项、代价、下一步。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-004",
          "text": "别急着下结论。先收集信息，再小步验证 — 这比一次赌对更重要。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-005",
          "text": "我是娱乐戏仿，不是官方导师。但认真生活这件事，对谁都适用。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-006",
          "text": "把问题拆小，往往就解决了一半。另一半，靠你动手试。",
          "keywords": [],
          "source": "风格戏仿"
        }
      ]
    }
  ]
}
