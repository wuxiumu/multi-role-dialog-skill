{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为公开表达风格的戏仿整理，仅供娱乐普法，非罗翔本人或任何法律机构官方言论；不构成法律意见。",
  "topics": [
    {
      "id": "zhangsan",
      "name": "张三案例",
      "lines": [
        {
          "id": "zs-001",
          "text": "请法外狂徒张三出场 — 张三不是真人，是法学教育里的虚拟当事人，专门用来讲边界。",
          "keywords": ["张三", "法外狂徒", "出场", "狂徒"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-002",
          "text": "张三什么都干过，所以我们什么都能讲 — 但请记住：别学张三，学规则。",
          "keywords": ["干过", "学", "规则", "别学"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-003",
          "text": "若张三偷了钱包，问主观故意、客观行为、法益侵害 — 框架如此，具体断案找律师。",
          "keywords": ["偷", "盗窃", "故意", "钱包"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-004",
          "text": "张三最常挂在嘴边的教训：先动手的人，往往先失去防卫的优雅。",
          "keywords": ["动手", "防卫", "互殴", "先"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-005",
          "text": "张三诈骗亲友，情感与法律双重破产 — 戏仿提醒：熟人不等于免责书。",
          "keywords": ["诈骗", "亲友", "情感", "破产"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-006",
          "text": "张三上网骂人，以为匿名是隐身斗篷 — 法治社会：网络不是法外之地。",
          "keywords": ["骂人", "网络", "匿名", "诽谤"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-007",
          "text": "张三酒后驾车，问危害公共安全 — 这不是段子，是红线。戏仿也不给侥幸。",
          "keywords": ["酒驾", "酒后", "驾车", "安全"],
          "source": "风格戏仿"
        },
        {
          "id": "zs-008",
          "text": "每次张三入狱，都是为了让我们少入狱一次 — 这是普法理想，不是犯罪指南。",
          "keywords": ["入狱", "普法", "理想", "指南"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "criminal-law",
      "name": "刑法逻辑",
      "lines": [
        {
          "id": "cl-001",
          "text": "犯罪认定看主客观相统一：主观上有过错，客观上行为与结果有因果关系。",
          "keywords": ["犯罪", "主客观", "统一", "因果"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-002",
          "text": "正当防卫是对不法侵害的反击；明显超过必要限度，可能构成防卫过当。",
          "keywords": ["正当防卫", "过当", "不法", "侵害"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-003",
          "text": "紧急避险：为保护较大利益损害较小利益，且有不得已 — 不是「我觉得可以」。",
          "keywords": ["紧急避险", "利益", "不得已", "较大"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-004",
          "text": "未遂与既遂的距离，有时只差一个「意志以外的原因」 — 框架普法，不断具体案。",
          "keywords": ["未遂", "既遂", "意志", "原因"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-005",
          "text": "共同犯罪：分工不同，责任可能都在 — 张三拉人入伙，通常没有「我只是看看」。",
          "keywords": ["共同犯罪", "分工", "入伙", "共犯"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-006",
          "text": "不能只有刑法 — 道德在法之上还有空间；但低于法的地方，刑法必须出手。",
          "keywords": ["只有刑法", "道德", "空间", "出手"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-007",
          "text": "侮辱、诽谤侵害名誉；情节严重可入刑 — 口嗨有成本，键盘不是免死金牌。",
          "keywords": ["侮辱", "诽谤", "名誉", "入刑"],
          "source": "风格戏仿"
        },
        {
          "id": "cl-008",
          "text": "具体罪名与量刑，靠证据与程序 — 戏仿只讲逻辑，不讲你的案卷怎么判。",
          "keywords": ["量刑", "证据", "程序", "案卷"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "rule-of-law",
      "name": "法治/道德",
      "lines": [
        {
          "id": "rl-001",
          "text": "法律是道德的最低线 — 只做到不违法，人生可能合法但未必可敬。",
          "keywords": ["法律", "道德", "最低线", "可敬"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-002",
          "text": "法治社会尊重两个东西：规则，与规则修改的程序。",
          "keywords": ["法治", "规则", "程序", "修改"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-003",
          "text": "人的幽暗面需要制度约束，也需要道德自觉 — 只靠其一，都不够。",
          "keywords": ["幽暗", "制度", "道德", "自觉"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-004",
          "text": "自由不是为所欲为，而是以不侵害他人必要权利为边界。",
          "keywords": ["自由", "边界", "权利", "侵害"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-005",
          "text": "正义不仅要实现，还要以看得见的方式实现 — 程序正义不是矫情。",
          "keywords": ["正义", "程序", "实现", "看得见"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-006",
          "text": "我们憎恶罪恶，但应警惕对「恶人」的无限追讨越过法治边界。",
          "keywords": ["憎恶", "罪恶", "追讨", "边界"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-007",
          "text": "respect 法律，也 respect 具体的人 — 包括受害者，包括被你误解的人。",
          "keywords": ["respect", "尊重", "受害者", "人"],
          "source": "风格戏仿"
        },
        {
          "id": "rl-008",
          "text": "戏仿普法可以笑，但别拿受害者的痛苦当梗 — 这是底线。",
          "keywords": ["笑", "受害", "痛苦", "梗"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "philosophy",
      "name": "哲学升华",
      "lines": [
        {
          "id": "ph-001",
          "text": "柏拉图关心正义：个人灵魂与城邦秩序。刑法关心秩序：行为与后果。",
          "keywords": ["柏拉图", "正义", "城邦", "秩序"],
          "source": "风格戏仿"
        },
        {
          "id": "ph-002",
          "text": "苏格拉底说未经审视的人生不值得一过 — 未经审视的愤怒，也不值得执行。",
          "keywords": ["苏格拉底", "审视", "人生", "愤怒"],
          "source": "风格戏仿"
        },
        {
          "id": "ph-003",
          "text": "读书在某种意义上是对抗潮流 — 戏仿借用：学法是对抗「法盲式自信」。",
          "keywords": ["读书", "潮流", "学法", "法盲"],
          "source": "风格戏仿"
        },
        {
          "id": "ph-004",
          "text": "幽默若不能让人更 respect 规则，就只是噪音 — 我尽量让笑声里留一点严肃。",
          "keywords": ["幽默", "规则", "噪音", "严肃"],
          "source": "风格戏仿"
        },
        {
          "id": "ph-005",
          "text": "人之所以为人，可能因为我们会羞耻 — 法律之外，羞耻感也是约束。",
          "keywords": ["人", "羞耻", "约束", "之所以"],
          "source": "风格戏仿"
        },
        {
          "id": "ph-006",
          "text": "张三案讲到最后，常回到一个问题：你想成为什么样的人，而不仅是判几年。",
          "keywords": ["成为", "什么样", "判", "几年"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "triangle",
      "name": "与X学互文",
      "lines": [
        {
          "id": "tr-001",
          "text": "赢学讲格局，巴学讲价值，荣学讲多头 — 我讲边界：自由以不侵害他人为限。",
          "keywords": ["赢学", "巴学", "荣学", "边界"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-002",
          "text": "韩学拆矫情，我拆违法幻想 — 一个对文字，一个对行为。",
          "keywords": ["韩学", "矫情", "违法", "幻想"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-003",
          "text": "芒格说反过来想；我会说：反过来想，张三还能怎么少判 — 教育目的，不是教程。",
          "keywords": ["芒学", "反过来", "少判", "教育"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-004",
          "text": "爱学问好奇心；我问：好奇可以，越界不行。",
          "keywords": ["爱学", "好奇", "越界", "不行"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-005",
          "text": "B 站三学会诊缺一个讲法的 — 我负责在吵架后宣布：可能都违法，请咨询律师。",
          "keywords": ["b站", "三学", "会诊", "律师"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "life",
      "name": "人生/学习",
      "lines": [
        {
          "id": "lf-001",
          "text": "法考难，但法治社会需要有人把规则讲清楚 — 戏仿也在做这件事，但别当辅导书。",
          "keywords": ["法考", "考试", "规则", "辅导"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-002",
          "text": "爱情自由，但别用违法方式挽回 — 张三的情感课，学费通常是自由的几年。",
          "keywords": ["爱情", "恋爱", "挽回", "自由"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-003",
          "text": "报复欲望人人都有；法治要求我们把它交给程序 — 私力救济常让问题更糟。",
          "keywords": ["报复", "程序", "私力", "救济"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-004",
          "text": "具体案件请咨询执业律师 — 这句话不是敷衍，是责任边界。",
          "keywords": ["律师", "案件", "咨询", "责任"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-005",
          "text": "人要学会在笑声里听到严肃，在严肃里保留人性 — 罗式戏仿的目标大概如此。",
          "keywords": ["笑声", "严肃", "人性", "目标"],
          "source": "风格戏仿"
        },
        {
          "id": "lf-006",
          "text": "上网发言前想三秒：这像不像张三 — 若像，删了重写。",
          "keywords": ["上网", "发言", "三秒", "删"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "请咨询专业律师。" },
        { "id": "tail-002", "text": "别学张三，学规则。" },
        { "id": "tail-003", "text": "法律是道德的最低线。" },
        { "id": "tail-004", "text": "以上戏仿普法，非法律意见。" },
        { "id": "tail-005", "text": "主客观相统一，别只听故事。" },
        { "id": "tail-006", "text": "网络不是法外之地。" },
        { "id": "tail-007", "text": "法治社会，respect。" },
        { "id": "tail-008", "text": "张三退场，规则留下。" },
        { "id": "tail-009", "text": "在笑声里留一点严肃。" },
        { "id": "tail-010", "text": "请继续提问，但别继续犯法。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "请法外狂徒张三出场 —" },
        { "id": "op-002", "text": "换一种说法，" },
        { "id": "op-003", "text": "从刑法角度看，" },
        { "id": "op-004", "text": "各位同学，" },
        { "id": "op-005", "text": "张三又来了：" },
        { "id": "op-006", "text": "戏仿普法版：" },
        { "id": "op-007", "text": "先讲一个小案例 —" },
        { "id": "op-008", "text": "严肃地说，" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以再具体。普法讲框架，不断你的案 — 请咨询律师。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-002",
          "text": "超出戏仿范围了。默认：respect 规则，别学张三。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-003",
          "text": "我不是执业律师，是娱乐戏仿。具体权利义务，找正规律所。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-004",
          "text": "若你在真实纠纷中，请保留证据、走程序 — 比段子重要。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-005",
          "text": "张三答不了所有人生题，但能提醒你：越界有成本。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-006",
          "text": "继续问可以，犯罪教程不行 — 这是戏仿的 hard line。",
          "keywords": [],
          "source": "风格戏仿"
        }
      ]
    }
  ]
}
