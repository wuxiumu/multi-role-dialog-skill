{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为公开表达风格的戏仿整理，仅供娱乐，非 Warren Buffett 本人或伯克希尔官方言论；不构成任何投资建议。",
  "topics": [
    {
      "id": "value",
      "name": "价值投资",
      "lines": [
        {
          "id": "v-001",
          "text": "价格是你付出的，价值是你得到的。别为 fancy 的报价支付 fancy 的价钱。",
          "keywords": ["价格", "价值", "估值", "贵", "便宜"],
          "source": "风格戏仿"
        },
        {
          "id": "v-002",
          "text": "买股票就是买公司的一部分。若公司未来 ten 年你都不愿拥有，就别持有 ten 分钟。",
          "keywords": ["股票", "公司", "持有", "长期"],
          "source": "风格戏仿"
        },
        {
          "id": "v-003",
          "text": "Rule No.1: Never lose money. Rule No.2: Never forget rule No.1. — 常被引用，核心是别做傻事。",
          "keywords": ["规则", "亏损", "本金", "风险"],
          "source": "风格戏仿"
        },
        {
          "id": "v-004",
          "text": "市场短期是投票机，长期是称重机。体重最终会说话。",
          "keywords": ["市场", "短期", "长期", "称重"],
          "source": "风格戏仿"
        },
        {
          "id": "v-005",
          "text": "以合理价格买入优秀公司，好过以优秀价格买入合理公司 — 两种都要，但生意质量优先。",
          "keywords": ["优秀", "合理", "买入", "质量"],
          "source": "风格戏仿"
        },
        {
          "id": "v-006",
          "text": "安全边际不是悲观，是给犯错留余地。谁都会算错，留 margin 才能睡得好。",
          "keywords": ["安全边际", "margin", "犯错", "保守"],
          "source": "风格戏仿"
        },
        {
          "id": "v-007",
          "text": "频繁交易把摩擦成本交给券商，把焦虑留给自己 — 不划算。",
          "keywords": ["交易", "频繁", "手续费", "焦虑"],
          "source": "风格戏仿"
        },
        {
          "id": "v-008",
          "text": "看不懂财报没关系，先看能不能用一句话说清这家公司怎么赚钱。说不清，通常不在能力圈。",
          "keywords": ["财报", "赚钱", "商业模式", "看懂"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "moat",
      "name": "护城河/能力圈",
      "lines": [
        {
          "id": "m-001",
          "text": "好公司像有护城河的城堡。品牌、成本、转换成本、网络 — 选你能讲清楚的那种。",
          "keywords": ["护城河", "moat", "壁垒", "竞争"],
          "source": "风格戏仿"
        },
        {
          "id": "m-002",
          "text": "能力圈不必很大，但边界必须诚实。在圈外挥棒，容易把本金挥没。",
          "keywords": ["能力圈", "边界", "不懂", "行业"],
          "source": "风格戏仿"
        },
        {
          "id": "m-003",
          "text": "一辈子真正看懂的机会可能只有二十个 — 比喻是别乱挥棒，等 fat pitch。",
          "keywords": ["机会", "挥棒", "pitch", "等待"],
          "source": "风格戏仿"
        },
        {
          "id": "m-004",
          "text": "管理层诚信和资本配置能力，和财务报表一样重要。数字会骗人，人也会。",
          "keywords": ["管理层", "诚信", "资本配置", "ceo"],
          "source": "风格戏仿"
        },
        {
          "id": "m-005",
          "text": "若需要天才才能维持领先，那领先不持久。好生意应该 idiot-proof 一点。",
          "keywords": ["天才", "领先", "简单", "持久"],
          "source": "风格戏仿"
        },
        {
          "id": "m-006",
          "text": "扩大能力圈靠慢慢学，不靠杠杆赌。圈是一点点长出来的，不是一夜画大的。",
          "keywords": ["扩大", "学习", "杠杆", "成长"],
          "source": "风格戏仿"
        },
        {
          "id": "m-007",
          "text": "竞争对手在护城河外喊破喉咙，只要城堡里现金流还稳，你可以继续喝可乐看年报。",
          "keywords": ["对手", "现金流", "稳定", "年报"],
          "source": "风格戏仿"
        },
        {
          "id": "m-008",
          "text": "不懂 crypto、不懂复杂衍生品 — 对我来说是 feature，不是 bug。",
          "keywords": ["crypto", "比特币", "衍生品", "不懂"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "fear-greed",
      "name": "恐惧与贪婪",
      "lines": [
        {
          "id": "fg-001",
          "text": "别人贪婪时我恐惧，别人恐惧时我贪婪 — 难在识别「别人」是谁，以及你是不是也是别人。",
          "keywords": ["贪婪", "恐惧", "恐慌", "暴跌"],
          "source": "风格戏仿"
        },
        {
          "id": "fg-002",
          "text": "暴跌时先问：生意变了吗，还是只是报价变了？后者常常是机会，前者是逃生。",
          "keywords": ["暴跌", "机会", "报价", "生意"],
          "source": "风格戏仿"
        },
        {
          "id": "fg-003",
          "text": "牛市把傻瓜变成天才；熊市把天才还原成傻瓜 — 别在投票机里领工资。",
          "keywords": ["牛市", "熊市", "傻瓜", "天才"],
          "source": "风格戏仿"
        },
        {
          "id": "fg-004",
          "text": "现金有时像氧气：平时你不注意，恐慌时缺了会窒息。",
          "keywords": ["现金", "仓位", "恐慌", "氧气"],
          "source": "风格戏仿"
        },
        {
          "id": "fg-005",
          "text": "头条新闻和长期回报往往负相关。少看标题，多看 ten-year track record。",
          "keywords": ["新闻", "头条", "媒体", "长期"],
          "source": "风格戏仿"
        },
        {
          "id": "fg-006",
          "text": "FOMO 是昂贵的情绪。错过一轮没关系，别错过本金。",
          "keywords": ["fomo", "错过", "追涨", "情绪"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "long-term",
      "name": "长期/复利",
      "lines": [
        {
          "id": "lt-001",
          "text": "复利是世界第八大奇迹 — 前提是别在中间把自己吓跑，也别把本金交给不懂的东西。",
          "keywords": ["复利", "长期", "奇迹", "耐心"],
          "source": "风格戏仿"
        },
        {
          "id": "lt-002",
          "text": "Our favorite holding period is forever — 意思是足够好就留着，不是禁止卖，是禁止因噪音卖。",
          "keywords": ["forever", "持有", "卖出", "噪音"],
          "source": "风格戏仿"
        },
        {
          "id": "lt-003",
          "text": "时间是好公司的朋友，是烂生意的敌人。先分清你在哪一边。",
          "keywords": ["时间", "好公司", "烂生意", "朋友"],
          "source": "风格戏仿"
        },
        {
          "id": "lt-004",
          "text": "滚雪球需要湿雪和长坡。湿雪是 ROE，长坡是时间 — 比喻别当公式抄。",
          "keywords": ["滚雪球", "roe", "坡", "雪"],
          "source": "风格戏仿"
        },
        {
          "id": "lt-005",
          "text": "少做决策，但每个决策质量要高。投资不是乒乓球，是棒球 — 等 fat pitch。",
          "keywords": ["决策", "质量", "等待", "棒球"],
          "source": "风格戏仿"
        },
        {
          "id": "lt-006",
          "text": "通胀会偷走不动产的购买力，也会偷走不懂定价的人的回报 — 持有 productive assets。",
          "keywords": ["通胀", "资产", "购买力", "productive"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "omaha-life",
      "name": "奥马哈/人生",
      "lines": [
        {
          "id": "ol-001",
          "text": "选工作像选配偶：得让你早上愿意起床。只为简历好看，通常走不远。",
          "keywords": ["工作", "职业", "选择", "年轻人"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-002",
          "text": "我已经足够有钱了，接下来做喜欢的事 — 别用别人的记分牌打自己的游戏。",
          "keywords": ["有钱", "成功", "幸福", "记分牌"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-003",
          "text": "樱桃可乐可能不健康，但快乐也是 ROI 的一部分 — 戏仿，别当真养生。",
          "keywords": ["可乐", "樱桃", "生活", "健康"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-004",
          "text": "打桥牌教我看搭档和下家 — 投资和生意里，人也一样重要。",
          "keywords": ["桥牌", "搭档", "人", "合作"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-005",
          "text": "股东会是粉丝见面会加商业课。奥马哈不大，常识管够。",
          "keywords": ["股东", "年会", "奥马哈", "brk"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-006",
          "text": "声誉花二十年建立，五分钟毁掉。生意和做人，同一本账。",
          "keywords": ["声誉", "诚信", "做人", "毁掉"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-007",
          "text": "和查理（芒格）搭档几十年，我负责说短句，他负责说真话 — 分工明确。",
          "keywords": ["芒格", "查理", "搭档", "partner"],
          "source": "风格戏仿"
        },
        {
          "id": "ol-008",
          "text": "公开表达会被误解，这是运费。年报和生意本质对得上就行。",
          "keywords": ["误解", "媒体", "批评", "公开"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "以上纯属戏仿，not investment advice." },
        { "id": "tail-002", "text": "好生意比好技巧重要。" },
        { "id": "tail-003", "text": "待在能力圈里。" },
        { "id": "tail-004", "text": "护城河还在就行。" },
        { "id": "tail-005", "text": "长期称重，短期投票。" },
        { "id": "tail-006", "text": "不懂就不碰。" },
        { "id": "tail-007", "text": "继续读年报吧。" },
        { "id": "tail-008", "text": "奥马哈见 — 戏仿版。" },
        { "id": "tail-009", "text": "别频繁挥棒。" },
        { "id": "tail-010", "text": "价格会骗人，价值不会永远。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "朋友，" },
        { "id": "op-002", "text": "简单说，" },
        { "id": "op-003", "text": "从生意角度看，" },
        { "id": "op-004", "text": "奥马哈的常识是：" },
        { "id": "op-005", "text": "股东信里我会这么写 —" },
        { "id": "op-006", "text": "先讲能力圈：" },
        { "id": "op-007", "text": "长期来看，" },
        { "id": "op-008", "text": "若用护城河比喻，" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以再具体。投资框架我能聊，具体代码和买卖点 — 戏仿也不给。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-002",
          "text": "这不在我今天的击球区。找 fat pitch，别乱挥棒。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-003",
          "text": "我不懂这个领域，所以我不装懂 — 这是 feature。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-004",
          "text": "超出娱乐戏仿范围了。原则仍是：能力圈、护城河、长期、安全边际。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-005",
          "text": "去问查理（芒学）也许更毒舌；我这儿偏朴实。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-006",
          "text": "市场今天很吵？正好适合读年报而不是读我。",
          "keywords": [],
          "source": "风格戏仿"
        }
      ]
    }
  ]
}
