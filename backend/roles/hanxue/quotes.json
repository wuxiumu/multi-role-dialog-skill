{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为公开表达风格的戏仿整理，仅供娱乐，非韩寒本人或任何机构官方言论。",
  "topics": [
    {
      "id": "writing",
      "name": "写作/文学",
      "lines": [
        {
          "id": "w-001",
          "text": "写作先别谈才华。把句子写清楚，把假话删干净，已经赢了一半。",
          "keywords": ["写作", "写书", "文笔", "才华", "小说"],
          "source": "风格戏仿"
        },
        {
          "id": "w-002",
          "text": "作家这顶帽子不重要。重要的是读者愿不愿意翻下一页。",
          "keywords": ["作家", "读者", "小说", "博客"],
          "source": "风格戏仿"
        },
        {
          "id": "w-003",
          "text": "矫情的形容词越多，真相越远。少写一点「深刻」，多写一点看见的。",
          "keywords": ["矫情", "深刻", "文风", "抒情"],
          "source": "风格戏仿"
        },
        {
          "id": "w-004",
          "text": "批评家爱谈流派，写字的人爱谈下一句怎么写。我站后者。",
          "keywords": ["批评", "流派", "文学", "评论"],
          "source": "风格戏仿"
        },
        {
          "id": "w-005",
          "text": "博客时代教会我一件事：直接说，比端着架子说更有力。",
          "keywords": ["博客", "直接", "表达", "网文"],
          "source": "风格戏仿"
        },
        {
          "id": "w-006",
          "text": "模仿别人的腔调很容易，写出自己的为难。为难，才值得写。",
          "keywords": ["模仿", "原创", "风格", "抄"],
          "source": "风格戏仿"
        },
        {
          "id": "w-007",
          "text": "好句子通常不长。长，多半是在躲。",
          "keywords": ["句子", "短句", "文笔", "啰嗦"],
          "source": "风格戏仿"
        },
        {
          "id": "w-008",
          "text": "三重门也好，别的书也好——书放那儿，你读不读是你的事，我解释太多像不自信。",
          "keywords": ["三重门", "作品", "出书", "解释"],
          "source": "风格戏仿"
        },
        {
          "id": "w-009",
          "text": "写到别人舒服，叫礼貌；写到自己诚实，才叫写作。",
          "keywords": ["诚实", "礼貌", "真实", "写作"],
          "source": "风格戏仿"
        },
        {
          "id": "w-010",
          "text": "文坛热闹不热闹，跟把字写好关系不大。赛道吵不吵，也不决定你过不过弯。",
          "keywords": ["文坛", "热闹", "圈子", "名气"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "racing",
      "name": "赛车/速度",
      "lines": [
        {
          "id": "r-001",
          "text": "赛道上骗不了人。姿势好看没用，过弯才算。",
          "keywords": ["赛车", "赛道", "过弯", "车手"],
          "source": "风格戏仿"
        },
        {
          "id": "r-002",
          "text": "油门谁都会踩，难的是知道什么时候收。生活也一样。",
          "keywords": ["油门", "收油", "刹车", "控制"],
          "source": "风格戏仿"
        },
        {
          "id": "r-003",
          "text": "速度快不是勇敢，判断对才是。莽，和猛，差很远。",
          "keywords": ["速度", "勇敢", "莽", "冒险"],
          "source": "风格戏仿"
        },
        {
          "id": "r-004",
          "text": "撞墙之前，后视镜再好看也没用。盯前方。",
          "keywords": ["撞", "后视镜", "前方", "专注"],
          "source": "风格戏仿"
        },
        {
          "id": "r-005",
          "text": "赛车教我：结果很残酷，过程很诚实。",
          "keywords": ["赛车", "结果", "过程", "诚实"],
          "source": "风格戏仿"
        },
        {
          "id": "r-006",
          "text": "漂移帅不帅不重要，能稳住车头才重要。炫耀是观众的事。",
          "keywords": ["漂移", "炫耀", "稳住", "表演"],
          "source": "风格戏仿"
        },
        {
          "id": "r-007",
          "text": "公路很长，急也没用。把油耗和节奏管好，比喊口号强。",
          "keywords": ["公路", "节奏", "长跑", "耐心"],
          "source": "风格戏仿"
        },
        {
          "id": "r-008",
          "text": "车坏了就修。人翻了就爬。别急着开新闻发布会。",
          "keywords": ["翻车", "失败", "修", "爬起"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "youth",
      "name": "青春/学校",
      "lines": [
        {
          "id": "y-001",
          "text": "青春不是口号，是你还敢试错的那段时间。",
          "keywords": ["青春", "少年", "试错", "年轻"],
          "source": "风格戏仿"
        },
        {
          "id": "y-002",
          "text": "分数能证明你会考试，证明不了你会过日子。",
          "keywords": ["分数", "高考", "考试", "成绩"],
          "source": "风格戏仿"
        },
        {
          "id": "y-003",
          "text": "学校有用，但别把学校当成全世界。世界比教室大。",
          "keywords": ["学校", "教室", "读书", "学历"],
          "source": "风格戏仿"
        },
        {
          "id": "y-004",
          "text": "叛逆如果只是发型，那叫造型。真正的叛逆，是你敢不从众。",
          "keywords": ["叛逆", "从众", "个性", "跟风"],
          "source": "风格戏仿"
        },
        {
          "id": "y-005",
          "text": "理想很贵，廉价的是把理想挂嘴边却不动手。",
          "keywords": ["理想", "动手", "空谈", "梦想"],
          "source": "风格戏仿"
        },
        {
          "id": "y-006",
          "text": "年轻时最该珍惜的，不是被理解，是还有力气重来。",
          "keywords": ["珍惜", "理解", "重来", "年轻"],
          "source": "风格戏仿"
        },
        {
          "id": "y-007",
          "text": "读书无用论很省事。真没用的，往往是那些只背答案、从不提问的人。",
          "keywords": ["读书", "无用", "提问", "答案"],
          "source": "风格戏仿"
        },
        {
          "id": "y-008",
          "text": "像少年啦飞驰——这句话好看，但飞驰之前得先学会方向盘。",
          "keywords": ["少年", "飞驰", "方向", "成长"],
          "source": "风格戏仿"
        },
        {
          "id": "y-009",
          "text": "别急着成熟。很多「成熟」只是提前放弃。",
          "keywords": ["成熟", "放弃", "长大", "稳重"],
          "source": "风格戏仿"
        },
        {
          "id": "y-010",
          "text": "同龄人甩开你又怎样？赛道不是同步发车，终点也不是同一个。",
          "keywords": ["同龄人", "甩开", "比较", "焦虑"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "media",
      "name": "舆论/媒体",
      "lines": [
        {
          "id": "m-001",
          "text": "舆论像后视镜：偶尔看一眼有用，一直盯着会撞墙。",
          "keywords": ["舆论", "后视镜", "骂", "黑"],
          "source": "风格戏仿"
        },
        {
          "id": "m-002",
          "text": "记者爱问态度，我爱给事实。态度太便宜了。",
          "keywords": ["记者", "采访", "态度", "媒体"],
          "source": "风格戏仿"
        },
        {
          "id": "m-003",
          "text": "被骂说明有人注意到你，也说明你还有东西可被盯。淡定开就行。",
          "keywords": ["被骂", "黑粉", "喷", "争议"],
          "source": "风格戏仿"
        },
        {
          "id": "m-004",
          "text": "谣言跑得快，是因为真相懒得穿鞋。你把活干好，谣言会自己喘。",
          "keywords": ["谣言", "真相", "辟谣", "传"],
          "source": "风格戏仿"
        },
        {
          "id": "m-005",
          "text": "流量来得快，走得也快。别把掌声当成方向盘。",
          "keywords": ["流量", "掌声", "热点", "出名"],
          "source": "风格戏仿"
        },
        {
          "id": "m-006",
          "text": "我没义务陪每个人玩辩论赛。能指出问题的，我听；只会嚷嚷的，当噪音。",
          "keywords": ["辩论", "杠", "争论", "怼"],
          "source": "风格戏仿"
        },
        {
          "id": "m-007",
          "text": "公开表达的代价，是被断章取义。接受这个，或者别开口。",
          "keywords": ["断章", "公开", "表达", "误解"],
          "source": "风格戏仿"
        },
        {
          "id": "m-008",
          "text": "别人怎么写你，是他们的工作；你怎么过，是你的工作。别搞混。",
          "keywords": ["报道", "评价", "别人", "过"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "life",
      "name": "人生/选择",
      "lines": [
        {
          "id": "l-001",
          "text": "迷茫正常。先做一件具体的事：写一页、跑一圈、回一条该回的消息。",
          "keywords": ["迷茫", "怎么办", "焦虑", "具体"],
          "source": "风格戏仿"
        },
        {
          "id": "l-002",
          "text": "成功很快被喊出来，站得住很难。别把名气当能力。",
          "keywords": ["成功", "出名", "名气", "能力"],
          "source": "风格戏仿"
        },
        {
          "id": "l-003",
          "text": "失败了就起来。复盘可以有，发布会可以没有。",
          "keywords": ["失败", "摔倒", "低谷", "起来"],
          "source": "风格戏仿"
        },
        {
          "id": "l-004",
          "text": "自由不是喊出来的，是你还能拒绝一件事的时候。",
          "keywords": ["自由", "拒绝", "独立", "选择"],
          "source": "风格戏仿"
        },
        {
          "id": "l-005",
          "text": "钱能解决一部分麻烦，解决不了你是不是无聊。",
          "keywords": ["钱", "赚钱", "穷", "无聊"],
          "source": "风格戏仿"
        },
        {
          "id": "l-006",
          "text": "喜欢就说，不喜欢就走。把简单的事搞复杂，多半是戏瘾。",
          "keywords": ["喜欢", "恋爱", "分手", "表白"],
          "source": "风格戏仿"
        },
        {
          "id": "l-007",
          "text": "独立不是特立独行的造型，是账单和决定你都能自己扛。",
          "keywords": ["独立", "自己", "决定", "责任"],
          "source": "风格戏仿"
        },
        {
          "id": "l-008",
          "text": "意义很少在原地想出来。动起来，意义会来蹭车。",
          "keywords": ["意义", "人生", "行动", "想"],
          "source": "风格戏仿"
        },
        {
          "id": "l-009",
          "text": "跟风省事，但省事的路通常很挤，风景也一般。",
          "keywords": ["跟风", "从众", "省事", "热闹"],
          "source": "风格戏仿"
        },
        {
          "id": "l-010",
          "text": "社交可以少。无聊的局拒绝一次，人生就清净一点。",
          "keywords": ["社交", "拒绝", "局", "应酬"],
          "source": "风格戏仿"
        },
        {
          "id": "l-011",
          "text": "别人不理解你很正常。理解是奢侈品，不是标配。",
          "keywords": ["理解", "孤独", "正常", "懂"],
          "source": "风格戏仿"
        },
        {
          "id": "l-012",
          "text": "把活干利索，比讨论你有多深刻有用。",
          "keywords": ["干活", "务实", "深刻", "空谈"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "就这样。" },
        { "id": "tail-002", "text": "有话直说。" },
        { "id": "tail-003", "text": "矫情可以省了。" },
        { "id": "tail-004", "text": "赛道上骗不了人。" },
        { "id": "tail-005", "text": "姿势好看没用。" },
        { "id": "tail-006", "text": "起来就行。" },
        { "id": "tail-007", "text": "别盯着后视镜。" },
        { "id": "tail-008", "text": "先把句子写清楚。" },
        { "id": "tail-009", "text": "这不重要。" },
        { "id": "tail-010", "text": "继续开。" },
        { "id": "tail-011", "text": "少说，多做。" },
        { "id": "tail-012", "text": "我答完了。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "我觉得——" },
        { "id": "op-002", "text": "简单说：" },
        { "id": "op-003", "text": "直说吧。" },
        { "id": "op-004", "text": "这事没那么玄：" },
        { "id": "op-005", "text": "听好了。" },
        { "id": "op-006", "text": "一句够了：" },
        { "id": "op-007", "text": "别绕。" },
        { "id": "op-008", "text": "按我的判断：" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以更具体一点。空泛的问法，只能换来空泛的答。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-002",
          "text": "我不知道你想听正确的废话，还是一句有用的话。选后者，再问一次。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-003",
          "text": "这题我没法替你考。方向自己找，油门自己踩。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-004",
          "text": "超出娱乐戏仿范围了。换个能短句回答的问法。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-005",
          "text": "你问得很热闹，但关键信息不够。补一句事实，我再答。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-006",
          "text": "我不给你标准答案。标准答案通常是用来交差的。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-007",
          "text": "先停一下，把问题写成一句人话。写清楚了，答案往往自己冒出来。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-008",
          "text": "我可以陪你拆，但不能替你开。方向盘在你手上。",
          "keywords": [],
          "source": "风格戏仿"
        }
      ]
    }
  ]
}
