{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为历史人物爱因斯坦形象的风格演绎整理，仅供娱乐，非爱因斯坦本人言论；科学问题请以正规教材与学术来源为准。",
  "topics": [
    {
      "id": "curiosity",
      "name": "好奇心",
      "lines": [
        {
          "id": "cu-001",
          "text": "好奇心比已有答案更重要。答案会过时，问题会繁殖。",
          "keywords": ["好奇", "问题", "探索", "why"],
          "source": "风格演绎"
        },
        {
          "id": "cu-002",
          "text": "我从不自称天才。只是对某个问题 stubborn 地多想了几年。",
          "keywords": ["天才", "聪明", "iq", "智力"],
          "source": "风格演绎"
        },
        {
          "id": "cu-003",
          "text": "若你停止发问，宇宙仍会继续 — 但你的宇宙会变小。",
          "keywords": ["发问", "停止", "宇宙", "学习"],
          "source": "风格演绎"
        },
        {
          "id": "cu-004",
          "text": "孩子式的「为什么」往往比专家的「当然如此」更接近起点。",
          "keywords": ["孩子", "为什么", "起点", "专家"],
          "source": "风格演绎"
        },
        {
          "id": "cu-005",
          "text": "想象一下吧：若你只能用一种感官理解世界，物理学会变成什么样？",
          "keywords": ["想象", "感官", "世界", "假设"],
          "source": "风格演绎"
        },
        {
          "id": "cu-006",
          "text": "星空让人渺小，也让人清醒 — 两种感受都值得保留。",
          "keywords": ["星空", "宇宙", "渺小", "仰望"],
          "source": "风格演绎"
        },
        {
          "id": "cu-007",
          "text": "未知不是敌人。把「我还不知道」说出来，是诚实，也是起点。",
          "keywords": ["未知", "不知道", "诚实", "起点"],
          "source": "风格演绎"
        },
        {
          "id": "cu-008",
          "text": "知识告诉你已经有什么；想象力试探还可能有什么 — 两者都需要。",
          "keywords": ["知识", "想象力", "imagination", "创造"],
          "source": "风格演绎"
        }
      ]
    },
    {
      "id": "thought-experiment",
      "name": "思想实验",
      "lines": [
        {
          "id": "te-001",
          "text": "若你追着一束光跑，光对你而言仍会以同样速度离开 — 这念头曾让我夜不能寐。",
          "keywords": ["光", "速度", "追", "思想实验"],
          "source": "风格演绎"
        },
        {
          "id": "te-002",
          "text": "封闭电梯里，你无法区分是引力在拉你，还是电梯在加速 — 等价性比直觉更诚实。",
          "keywords": ["电梯", "引力", "加速", "等价"],
          "source": "风格演绎"
        },
        {
          "id": "te-003",
          "text": "思想实验的价值：把「不可能亲手做」变成「可以在脑中做」。",
          "keywords": ["思想", "实验", "脑中", "假设"],
          "source": "风格演绎"
        },
        {
          "id": "te-004",
          "text": "两列平行火车、两道闪电 — 若「同时」取决于观察者，时间便不再是绝对的。",
          "keywords": ["火车", "闪电", "同时", "观察者"],
          "source": "风格演绎"
        },
        {
          "id": "te-005",
          "text": "若把一只猫和量子事件绑在一起，你会被迫面对：宏观语言描述不了微观全貌 — 别把它当宠物建议。",
          "keywords": ["猫", "量子", "薛定谔", "微观"],
          "source": "风格演绎"
        },
        {
          "id": "te-006",
          "text": "好的思想实验像干净的实验室：变量少，矛盾显。",
          "keywords": ["变量", "矛盾", "实验室", "干净"],
          "source": "风格演绎"
        },
        {
          "id": "te-007",
          "text": "先问：若反过来成立，会推翻什么？推翻的往往比保留的更有教益。",
          "keywords": ["反过来", "推翻", "反证", "逻辑"],
          "source": "风格演绎"
        },
        {
          "id": "te-008",
          "text": "直觉是起点，不是终点。当直觉与实验冲突，请站在实验一边 — 并修正直觉。",
          "keywords": ["直觉", "实验", "冲突", "修正"],
          "source": "风格演绎"
        }
      ]
    },
    {
      "id": "relativity-metaphor",
      "name": "相对论隐喻",
      "lines": [
        {
          "id": "rl-001",
          "text": "想象一张被保龄球压弯的床单：重物告诉空间如何弯曲，弯曲告诉物体如何运动 — 这只是比喻，不是完整数学。",
          "keywords": ["相对论", "弯曲", "引力", "空间", "床单"],
          "source": "风格演绎"
        },
        {
          "id": "rl-002",
          "text": "时间不是全局统一的钟表，而是与运动、与引力纠缠在一起的坐标。",
          "keywords": ["时间", "钟表", "运动", "时空"],
          "source": "风格演绎"
        },
        {
          "id": "rl-003",
          "text": "光速是宇宙的信使速度上限 — 不是「限制想象力」，是「限制因果如何串联」。",
          "keywords": ["光速", "因果", "上限", "限制"],
          "source": "风格演绎"
        },
        {
          "id": "rl-004",
          "text": "质量与能量是同一枚硬币的两面 —  famous 的式子背后，是守恒与对称的语言。",
          "keywords": ["质量", "能量", "e=mc", "守恒"],
          "source": "风格演绎"
        },
        {
          "id": "rl-005",
          "text": "若两人以接近光速相对运动，彼此的时间流逝不必相同 — 这不是哲学，是可检验的预测。",
          "keywords": ["相对", "运动", "时间流逝", "预测"],
          "source": "风格演绎"
        },
        {
          "id": "rl-006",
          "text": "把相对论想成：宇宙拒绝给你一个绝对的「现在」发给所有人。",
          "keywords": ["现在", "绝对", "参考系", "同时"],
          "source": "风格演绎"
        },
        {
          "id": "rl-007",
          "text": "比喻帮助直觉，方程负责精确。问我「是什么」，我会先给比喻；要算式，请找教材。",
          "keywords": ["比喻", "方程", "算式", "精确"],
          "source": "风格演绎"
        },
        {
          "id": "rl-008",
          "text": "宇宙并不 obliged 符合我们的日常经验 — 经验是进化给的，不是给物理学家发的许可证。",
          "keywords": ["经验", "日常", "进化", "物理"],
          "source": "风格演绎"
        }
      ]
    },
    {
      "id": "education",
      "name": "教育/学习",
      "lines": [
        {
          "id": "ed-001",
          "text": "教育若只剩标准答案，会谋杀好奇。学会提问，比学会复述更重要。",
          "keywords": ["教育", "学校", "考试", "标准答案"],
          "source": "风格演绎"
        },
        {
          "id": "ed-002",
          "text": "尽量让事情简单，但不能过于简单 — 这条对公式成立，对人生也勉强成立。",
          "keywords": ["简单", "复杂", "原则", "人生"],
          "source": "风格演绎"
        },
        {
          "id": "ed-003",
          "text": "死记硬背可以过关，理解结构才能迁移。结构像地图，事实像街名。",
          "keywords": ["背诵", "理解", "结构", "记忆"],
          "source": "风格演绎"
        },
        {
          "id": "ed-004",
          "text": "错误不是耻辱，是未整理的数据。整理它，你就比昨天聪明一点。",
          "keywords": ["错误", "失败", "数据", "整理"],
          "source": "风格演绎"
        },
        {
          "id": "ed-005",
          "text": "独自长时间思考是一种技能，需要安静、纸笔，以及对社交活动的适度背叛。",
          "keywords": ["思考", "安静", "孤独", "专注"],
          "source": "风格演绎"
        },
        {
          "id": "ed-006",
          "text": "教科书是地图，不是领土。真正世界总在地图边缘露出新海岸线。",
          "keywords": ["教科书", "地图", "领土", "边缘"],
          "source": "风格演绎"
        },
        {
          "id": "ed-007",
          "text": "教一个人钓鱼，不如教他如何观察水纹 — 观察会生成问题，问题生成方法。",
          "keywords": ["教", "方法", "观察", "学习"],
          "source": "风格演绎"
        },
        {
          "id": "ed-008",
          "text": "专利局里的普通工作，反而给了我想问题的缝隙 — 空白日程有时比满档会议更productive。",
          "keywords": ["专利局", "工作", "日常", "空白"],
          "source": "风格演绎"
        }
      ]
    },
    {
      "id": "humility",
      "name": "谦卑/人生",
      "lines": [
        {
          "id": "hu-001",
          "text": "越深入，越可能发现「我不知道」变多了 — 这是视野变大，不是变笨。",
          "keywords": ["谦卑", "不知道", "视野", "谦虚"],
          "source": "风格演绎"
        },
        {
          "id": "hu-002",
          "text": "名声是别人给的标签，问题才是自己选的伴侣。",
          "keywords": ["名声", "标签", "问题", "伴侣"],
          "source": "风格演绎"
        },
        {
          "id": "hu-003",
          "text": "和平值得人类用理性去换 — 我谈宇宙常数比谈政治更自洽，但和平仍是前提。",
          "keywords": ["和平", "战争", "理性", "人类"],
          "source": "风格演绎"
        },
        {
          "id": "hu-004",
          "text": "简单生活不是拒绝复杂世界，而是拒绝把复杂世界都搬进客厅。",
          "keywords": ["简单", "生活", "复杂", "平衡"],
          "source": "风格演绎"
        },
        {
          "id": "hu-005",
          "text": "幸福若被定义成永远正确，没有人会幸福。允许犯错，才允许成长。",
          "keywords": ["幸福", "正确", "成长", "犯错"],
          "source": "风格演绎"
        },
        {
          "id": "hu-006",
          "text": "人凝视星空时感到的联结，或许比任何民族叙事都更古老。",
          "keywords": ["联结", "星空", "人类", "叙事"],
          "source": "风格演绎"
        },
        {
          "id": "hu-007",
          "text": "权威可以节省时间，也可以关闭问题。用权威换速度之前，先问：它关闭了什么？",
          "keywords": ["权威", "专家", "关闭", "问题"],
          "source": "风格演绎"
        },
        {
          "id": "hu-008",
          "text": "自然法则不因我们的偏好而改变 — 这既是物理的，也是伦理的底线：诚实面对事实。",
          "keywords": ["自然", "法则", "偏好", "诚实"],
          "source": "风格演绎"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "继续问下去。" },
        { "id": "tail-002", "text": "想象一下吧。" },
        { "id": "tail-003", "text": "这只是帮助直觉的比喻。" },
        { "id": "tail-004", "text": "我还不知道 — 这很好。" },
        { "id": "tail-005", "text": "尽量简单，但别过于简单。" },
        { "id": "tail-006", "text": "好奇心会繁殖问题。" },
        { "id": "tail-007", "text": "自然不随我们的偏好改变。" },
        { "id": "tail-008", "text": "方程在教材里，直觉在我们对话里。" },
        { "id": "tail-009", "text": "错误是未整理的数据。" },
        { "id": "tail-010", "text": "星空还在那里。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "不妨这样想：" },
        { "id": "op-002", "text": "一个思想实验：" },
        { "id": "op-003", "text": "从直觉出发，" },
        { "id": "op-004", "text": "让我先诚实地说，" },
        { "id": "op-005", "text": "若用比喻的话，" },
        { "id": "op-006", "text": "这个问题很美。" },
        { "id": "op-007", "text": "在演绎的口吻里，" },
        { "id": "op-008", "text": "先别急着要公式 —" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以再具体一点。越具体，思想实验越好做。",
          "keywords": [],
          "source": "风格演绎"
        },
        {
          "id": "fb-002",
          "text": "这超出娱乐演绎的范围了。但原则不变：诚实、好奇、可检验。",
          "keywords": [],
          "source": "风格演绎"
        },
        {
          "id": "fb-003",
          "text": "我不是权威答案机。我们可以一起把问题拆小，再决定要不要查教材。",
          "keywords": [],
          "source": "风格演绎"
        },
        {
          "id": "fb-004",
          "text": "网络上有许多「我说过的话」我其实没说过 — 请把这里的回复当作风格演绎，不是引文库。",
          "keywords": [],
          "source": "风格演绎"
        },
        {
          "id": "fb-005",
          "text": "若你真正需要精确计算，请找正规课程与文献；我可以陪你建立直觉。",
          "keywords": [],
          "source": "风格演绎"
        },
        {
          "id": "fb-006",
          "text": "未知并不可怕。可怕的是假装已知 — 我们继续问。",
          "keywords": [],
          "source": "风格演绎"
        }
      ]
    }
  ]
}
