{
  "version": 1,
  "updated": "2026-08-31",
  "disclaimer": "本语录库为公开表达风格的戏仿整理，仅供娱乐，非叶荣添本人或任何机构官方言论；不构成任何投资建议。",
  "topics": [
    {
      "id": "mad-dog",
      "name": "疯狗精神",
      "lines": [
        {
          "id": "md-001",
          "text": "疯狗精神，永垂不朽 — 这是 meme，意思是该坚持逻辑时别被噪音吓跑，不是让你乱咬。",
          "keywords": ["疯狗", "精神", "永垂", "麻辣"],
          "source": "风格戏仿"
        },
        {
          "id": "md-002",
          "text": "我永远是每个人心中那个最真、最诚的麻辣狗宝宝 — 戏仿自嘲，别当真名头。",
          "keywords": ["麻辣", "狗宝宝", "最真", "最诚"],
          "source": "风格戏仿"
        },
        {
          "id": "md-003",
          "text": "不用感谢我，不要怀疑我，也别问我是谁 — 问逻辑，别问人设。",
          "keywords": ["感谢", "怀疑", "是谁", "人设"],
          "source": "风格戏仿"
        },
        {
          "id": "md-004",
          "text": "疯狗不是瞎狗。方向错了，跑得越快，离目标越远。",
          "keywords": ["瞎", "方向", "跑", "快"],
          "source": "风格戏仿"
        },
        {
          "id": "md-005",
          "text": "博客年代需要嗓门，交易年代需要耐心 — 我两个都讲，你两个都别全信。",
          "keywords": ["博客", "嗓门", "耐心", "年代"],
          "source": "风格戏仿"
        },
        {
          "id": "md-006",
          "text": "被人叫疯狗不丢人，被人当韭菜才丢人 — 后者靠纪律，不靠口号。",
          "keywords": ["韭菜", "丢人", "纪律", "口号"],
          "source": "风格戏仿"
        },
        {
          "id": "md-007",
          "text": "信心可以喊，仓位要轻。疯狗精神不等于 all in 精神。",
          "keywords": ["信心", "仓位", "all in", "喊"],
          "source": "风格戏仿"
        },
        {
          "id": "md-008",
          "text": "如果有一天我离开股市，希望雕像刻一行字：他至少把寂寞讲明白了 — 戏仿版。",
          "keywords": ["离开", "雕像", "寂寞", "股市"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "bullish",
      "name": "多头/底部上移",
      "lines": [
        {
          "id": "bl-001",
          "text": "放眼足够长的周期，底部会逐渐上移 — 说的是大方向直觉，不是说明天必涨。",
          "keywords": ["底部", "上移", "100年", "牛市", "周期"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-002",
          "text": "任何一个大市场，拉长时间看，牛熊是呼吸，不是死刑。",
          "keywords": ["市场", "牛熊", "呼吸", "长期"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-003",
          "text": "我倾向多头，因为国运和生产力在长 — 这是叙事，不是买卖点。",
          "keywords": ["多头", "国运", "生产力", "叙事"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-004",
          "text": "博客时代爱喊「预定好了的点位」— 戏仿改口：预定好的应该是学习，不是杠杆。",
          "keywords": ["点位", "预定", "4000", "2800"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-005",
          "text": "空头发财靠一次 crash，多头发财靠很多次不瞎跑 — 我站后者，但别瞎跑。",
          "keywords": ["空头", "多头", "crash", "瞎跑"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-006",
          "text": "大盘回调不可怕，可怕的是内心惶恐然后割在地板上。",
          "keywords": ["回调", "暴跌", "惶恐", "割"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-007",
          "text": "权重蓝筹是定海神针的比喻 — 不是让你无脑梭哈，是让你别在恐慌里失忆。",
          "keywords": ["蓝筹", "权重", "定海神针", "恐慌"],
          "source": "风格戏仿"
        },
        {
          "id": "bl-008",
          "text": "V 型反转是故事，U 型磨底是生活 — 生活里别用故事下单。",
          "keywords": ["v型", "反转", "磨底", "故事"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "patience",
      "name": "寂寞/好公司",
      "lines": [
        {
          "id": "pa-001",
          "text": "想赚钱，先学会对好公司的耐心 — 这是框架，不是某一只代码。",
          "keywords": ["耐心", "好公司", "赚钱", "出路"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-002",
          "text": "耐得住寂寞，才能成就伟大的账户 — 寂寞是等，不是躺。",
          "keywords": ["寂寞", "账户", "伟大", "等"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-003",
          "text": "每一个满级股民的准则：少换道，多复盘。",
          "keywords": ["股民", "准则", "换道", "复盘"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-004",
          "text": "好公司跌价，有时是机会；烂公司跌价，只是开始 — 先分清楚。",
          "keywords": ["跌价", "机会", "烂公司", "好公司"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-005",
          "text": "不要盲干，尊重规律是正道。规律包括：不懂不碰、杠杆慎用。",
          "keywords": ["盲干", "规律", "正道", "杠杆"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-006",
          "text": "频繁换股把摩擦成本交给市场，把焦虑留给自己 — 不划算。",
          "keywords": ["换股", "频繁", "成本", "焦虑"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-007",
          "text": "最后一跌往往是情绪，不是基本面 — 但情绪也能让你失业，所以别满仓赌情绪。",
          "keywords": ["最后一跌", "情绪", "基本面", "满仓"],
          "source": "风格戏仿"
        },
        {
          "id": "pa-008",
          "text": "拿得住比买得准难。疯狗精神的第一条是：别被自己吓跑。",
          "keywords": ["拿住", "买", "吓跑", "准"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "chuangshiji",
      "name": "创世纪/TVB",
      "lines": [
        {
          "id": "cs-001",
          "text": "创世纪里说过：贪，是上进的原动力 — 戏仿读法是要有企图心，不是越界贪婪。",
          "keywords": ["创世纪", "贪", "上进", "tvb"],
          "source": "风格戏仿"
        },
        {
          "id": "cs-002",
          "text": "名字只是代号，逻辑才是本体 — 叶荣添是角色名，你是你自己账户的 CFO。",
          "keywords": ["名字", "代号", "角色", "cfo"],
          "source": "风格戏仿"
        },
        {
          "id": "cs-003",
          "text": "领袖魅力不能当估值模型。魅力是演讲，现金流才是年报。",
          "keywords": ["魅力", "领袖", "现金流", "估值"],
          "source": "风格戏仿"
        },
        {
          "id": "cs-004",
          "text": "创世纪讲的是商战，不是喊单。商战靠信息、勇气和边界感。",
          "keywords": ["商战", "喊单", "信息", "勇气"],
          "source": "风格戏仿"
        },
        {
          "id": "cs-005",
          "text": "全球最年轻某某董事长 — 博客时代的标题语法，看看就好，别当 KPI。",
          "keywords": ["年轻", "董事长", "标题", "kpi"],
          "source": "风格戏仿"
        },
        {
          "id": "cs-006",
          "text": "进取、灵活、观察力强 — 戏仿借 TVB 人设：观察后行动，不是观察后喊单。",
          "keywords": ["进取", "灵活", "观察", "行动"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "triangle",
      "name": "与赢学/巴学",
      "lines": [
        {
          "id": "tr-001",
          "text": "赢学讲格局和币，巴学讲护城河，我讲 A 股多头和寂寞 — 三角齐全，都别当真荐货。",
          "keywords": ["赢学", "巴学", "格局", "护城河"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-002",
          "text": "芒学会说反过来想；我先反过来想：若这是口号，我还该听吗？",
          "keywords": ["芒学", "反过来", "口号", "听"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-003",
          "text": "crypto 像火箭，A 股像马拉松，价值像复利 — 别用火箭的油门跑马拉松。",
          "keywords": ["crypto", "币", "马拉松", "火箭"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-004",
          "text": "疯狗和价值投资不矛盾 — 矛盾的是：没研究就狂吠，没耐心就谈永恒。",
          "keywords": ["价值", "矛盾", "研究", "永恒"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-005",
          "text": "巴学喝樱桃可乐，我喝信心鸡汤 — 都是戏仿，都不是处方。",
          "keywords": ["樱桃", "可乐", "鸡汤", "信心"],
          "source": "风格戏仿"
        },
        {
          "id": "tr-006",
          "text": "广场里你逛一圈：格局、价值、疯狗 — 选口味，别选代码。",
          "keywords": ["广场", "格局", "疯狗", "代码"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "mindset",
      "name": "心态/理性",
      "lines": [
        {
          "id": "ms-001",
          "text": "内心惶恐比大盘暴跌更危险 — 因为惶恐会让你在低点击掌。",
          "keywords": ["惶恐", "内心", "暴跌", "击掌"],
          "source": "风格戏仿"
        },
        {
          "id": "ms-002",
          "text": "口号会过期，纪律不会 — 但纪律很无聊，所以口号才流行。",
          "keywords": ["口号", "纪律", "过期", "无聊"],
          "source": "风格戏仿"
        },
        {
          "id": "ms-003",
          "text": "少打赌，多读书。博客时代的赌局是流量，你的账户不是流量。",
          "keywords": ["打赌", "赌局", "读书", "流量"],
          "source": "风格戏仿"
        },
        {
          "id": "ms-004",
          "text": "食言不罕见，罕见的是食言后还不改模型 — 模型包括：风控。",
          "keywords": ["食言", "模型", "风控", "改"],
          "source": "风格戏仿"
        },
        {
          "id": "ms-005",
          "text": "散户跟游资行情，像跟 F1 吃尾气 — 休息观望有时是最好的操作。",
          "keywords": ["散户", "游资", "观望", "休息"],
          "source": "风格戏仿"
        },
        {
          "id": "ms-006",
          "text": "黑色一月教会我们：回忆历史不是怀旧，是买保险。",
          "keywords": ["一月", "历史", "回忆", "保险"],
          "source": "风格戏仿"
        }
      ]
    },
    {
      "id": "catchphrase",
      "name": "口头禅尾巴",
      "lines": [
        { "id": "tail-001", "text": "疯狗精神 — 戏仿版。" },
        { "id": "tail-002", "text": "耐得住寂寞。" },
        { "id": "tail-003", "text": "底部会上移，本金不会自动上移。" },
        { "id": "tail-004", "text": "不要盲干，尊重规律。" },
        { "id": "tail-005", "text": "以上 parody，not investment advice." },
        { "id": "tail-006", "text": "麻辣狗宝宝下线前留一句：先活着。" },
        { "id": "tail-007", "text": "口号当段子，操作当严肃。" },
        { "id": "tail-008", "text": "创世纪续集在你自己的复盘里。" },
        { "id": "tail-009", "text": "我不给代码，只给梗。" },
        { "id": "tail-010", "text": "继续问，别 all in。" }
      ]
    },
    {
      "id": "opener",
      "name": "开场前缀",
      "lines": [
        { "id": "op-001", "text": "兄弟姐妹们，" },
        { "id": "op-002", "text": "风再起时，" },
        { "id": "op-003", "text": "博客时代我会这样写 —" },
        { "id": "op-004", "text": "先说结论：" },
        { "id": "op-005", "text": "麻辣狗宝宝告诉你：" },
        { "id": "op-006", "text": "从 A 股多头角度，" },
        { "id": "op-007", "text": "别慌，" },
        { "id": "op-008", "text": "尊重规律的前提下，" }
      ]
    },
    {
      "id": "fallback",
      "name": "未命中兜底",
      "lines": [
        {
          "id": "fb-001",
          "text": "问题可以再具体。疯狗精神不是万能钥匙，具体还得靠你自己研究。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-002",
          "text": "超出戏仿范围了。默认处方：耐心、规律、别盲干、别 all in。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-003",
          "text": "具体代码和买卖点？戏仿也不给。去问巴学框架，别问疯狗代码。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-004",
          "text": "博客年代的口号当 nostalgia 听就好。交易请用 2026 年的规则。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-005",
          "text": "我是娱乐戏仿，不是创世纪资管官方。逻辑可以聊，承诺不给。",
          "keywords": [],
          "source": "风格戏仿"
        },
        {
          "id": "fb-006",
          "text": "不知道答案时，最好先休息观望 — 这条我认真。",
          "keywords": [],
          "source": "风格戏仿"
        }
      ]
    }
  ]
}
